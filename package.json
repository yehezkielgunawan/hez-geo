{
  "name": "hez-geo",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "preview": "$npm_execpath run build && vite preview",
    "deploy": "$npm_execpath run build && wrangler deploy",
    "cf-typegen": "wrangler types --env-interface CloudflareBindings"
  },
  "dependencies": {
    "hono": "^4.13.7",
    "maplibre-gl": "^6.8.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.44.0",
    "typescript": "^7.0.2",
    "vite": "^8.1.4",
    "vite-ssr-components": "^0.6.1",
    "vitest": "^5.0.0",
    "wrangler": "^4.110.0"
  }
}
